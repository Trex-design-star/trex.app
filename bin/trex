#!/usr/bin/env ruby
# Trex CLI — operate the platform from your terminal.
# Secrets NEVER go in chat, files, or flags: the CLI reads them from
# environment variables or your macOS Keychain.
#
#   export TREX_API=http://localhost:8080            # default
#   export RESEND_API_KEY=re_xxx                     # only on the server, never here
#   bin/trex status | ledger | trades | disputes | resolve | pause | config | audit
require 'net/http'
require 'json'
require 'uri'
require 'optparse'

BASE = ENV.fetch('TREX_API', 'http://localhost:3001')

def call(method, path, body = nil, key = nil)
  uri = URI(BASE + '/api' + path)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = uri.scheme == 'https'
  req = method == :get ? Net::HTTP::Get.new(uri) : Net::HTTP::Post.new(uri.path)
  req['Content-Type'] = 'text/plain;charset=UTF-8'
  b = body ? body.dup : nil
  b['idempotency_key'] = key if key && b
  req.body = JSON.generate(b) if b
  resp = http.request(req)
  JSON.parse(resp.body)
rescue StandardError => e
  abort "trex: cannot reach #{BASE} (#{e.message}) — is the API running?"
end

def key
  'k-' + Time.now.to_i.to_s(36) + rand(36**6).to_s(36)
end

cmd = ARGV.shift
case cmd
when 'status', nil
  h = call(:get, '/health')
  i = call(:get, '/integrations')
  puts "api: #{h['ok'] ? 'up' : 'DOWN'} (#{h['time']})"
  puts "resend=#{i['resend']} sms=#{i['sms']} paystack=#{i['paystack']}"
when 'ledger'
  l = call(:get, '/ledger')['ledger']
  l.last(15).each { |e| puts "#{e['at']}  #{e['kind'].ljust(8)} #{e['amount']} #{e['ccy']}  #{e['trade']}" }
when 'trades'
  call(:get, '/trades')['trades'].last(10).each { |t| puts "#{t['id']}  #{t['sell']}->#{t['recv']}  #{t['amount']}  #{t['state']}" }
when 'disputes'
  call(:get, '/disputes')['disputes'].each { |d| puts "#{d['id']}  #{d['pair']}  #{d['amount']} #{d['cur']}  #{d['state']}" }
when 'resolve'
  id, how, second = nil, 'EXONERATED', nil
  OptionParser.new do |o|
    o.on('--id ID') { |v| id = v }
    o.on('--how HOW') { |v| how = v }
    o.on('--second NAME') { |v| second = v }
  end.parse!(ARGV)
  abort 'trex resolve --id DSP-XXX --how VENDOR-AT-FAULT|EXONERATED|PARTIAL [--second NAME]' unless id
  r = call(:post, '/resolve', { 'id' => id, 'how' => how, 'second_approval' => second }, key)
  puts r['ok'] ? "resolved #{id} as #{how}" : "FAILED: #{r['error']}"
when 'pause', 'resume'
  a, b = ARGV
  abort 'usage: trex pause USD JPY' unless a && b
  cfg = call(:get, '/config')['config']
  pairs = cfg['pausedPairs'] || []
  k = "#{a}-#{b}"
  pairs = cmd == 'pause' ? (pairs | [k]) : (pairs - [k] - ["#{b}-#{a}"])
  call(:post, '/config', { 'pausedPairs' => pairs })
  puts "#{cmd}d #{k}"
when 'config'
  if ARGV.empty?
    puts JSON.pretty_generate(call(:get, '/config')['config'])
  else
    patch = {}
    ARGV.each_slice(2) { |k, v| patch[k] = v.include?('.') ? v.to_f : v.to_i }
    puts JSON.pretty_generate(call(:post, '/config', patch)['config'])
  end
when 'audit'
  call(:get, '/audit')['audit'].last(15).each { |l| puts l }
when 'bond'
  puts JSON.pretty_generate(call(:get, '/bond')['bond'])
when 'otp'
  target = ARGV[0] or abort 'usage: trex otp you@example.com'
  r = call(:post, '/otp', target.include?('@') ? { 'email' => target } : { 'phone' => target })
  puts r['ok'] ? (r['email_sent'] ? 'sent to inbox' : (r['sms_sent'] ? 'text sent' : "preview code: #{r['demo_code']}")) : "FAILED: #{r['error']}"
else
  puts 'usage: trex <status|ledger|trades|disputes|resolve|pause|resume|config|audit|bond|otp>'
  exit 1
end
