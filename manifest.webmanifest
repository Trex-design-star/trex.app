{
  "id": "/",
  "name": "Trex — Trade currencies with people you can trust",
  "short_name": "Trex",
  "description": "A protected peer-to-peer currency marketplace. Every trade is bond-backed, with proof and chat built in.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dashboard.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#2A0A54",
  "theme_color": "#2A0A54",
  "categories": [
    "finance",
    "business"
  ],
  "prefer_related_applications": false,
